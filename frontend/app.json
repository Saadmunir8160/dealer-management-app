{
  "expo": {
    "name": "UCIC Customer Portal",
    "slug": "yahyakhan",
    "version": "1.0.13",
    "orientation": "portrait",
    "icon": "./assets/ucic-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": "1.0.13",
    "updates": {
      "url": "https://u.expo.dev/37684f22-bb57-4f27-a763-d23f5d6fcc52",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "splash": {
      "image": "./assets/logo-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E40AF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ucic.customerportal",
      "buildNumber": "14",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Microphone is used for voice ordering.",
        "NSSpeechRecognitionUsageDescription": "Speech recognition is used to fill order fields from voice.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ucic.customerportal",
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/ucic-logo.png",
        "backgroundColor": "#1E40AF"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "./plugins/withNetworkSecurityConfig.js",
      "expo-updates",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Microphone is used for voice ordering.",
          "speechRecognitionPermission": "Speech recognition is used to fill order fields from voice.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableJetifier": true,
            "newArchEnabled": true
          },
          "ios": {
            "deploymentTarget": "15.1",
            "newArchEnabled": true
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "37684f22-bb57-4f27-a763-d23f5d6fcc52"
      }
    },
    "owner": "khanyahyas-team"
  }
}
