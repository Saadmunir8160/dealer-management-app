{
  "expo": {
    "name": "UCIC Customer Portal",
    "slug": "moeez",
    "version": "1.0.15",
    "orientation": "portrait",
    "icon": "./assets/ucic-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": "1.0.15",
    "updates": {
      "url": "https://u.expo.dev/a638c699-3c81-4ea1-b2db-8c3a6832f9c2",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "splash": {
      "image": "./assets/logo-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E40AF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ucic.customerportal",
      "buildNumber": "16",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Microphone is used for voice ordering.",
        "NSSpeechRecognitionUsageDescription": "Speech recognition is used to fill order fields from voice.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ucic.customerportal",
      "versionCode": 16,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/ucic-icon.png",
        "backgroundColor": "#1E40AF"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#1E40AF",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content",
      "enforceContrast": true
    },
    "plugins": [
      "./plugins/withNetworkSecurityConfig.js",
      "expo-updates",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Microphone is used for voice ordering.",
          "speechRecognitionPermission": "Speech recognition is used to fill order fields from voice.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableJetifier": true,
            "newArchEnabled": true
          },
          "ios": {
            "deploymentTarget": "15.1",
            "newArchEnabled": true
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "a638c699-3c81-4ea1-b2db-8c3a6832f9c2"
      }
    },
    "owner": "khanmoeezs-team"
  }
}
