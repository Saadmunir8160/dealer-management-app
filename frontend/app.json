{
  "expo": {
    "name": "UCIC Customer Portal",
    "slug": "ucic-customer-portal",
    "version": "1.0.9",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "runtimeVersion": "1.0.9",
    "updates": {
      "url": "https://u.expo.dev/ca204142-be2c-4e3c-bef4-8f680286bde6",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "splash": {
      "image": "./assets/logo-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E40AF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ucic.customerportal",
      "buildNumber": "10",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Microphone is used for voice ordering.",
        "NSSpeechRecognitionUsageDescription": "Speech recognition is used to fill order fields from voice."
      }
    },
    "android": {
      "package": "com.ucic.customerportal",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#1E40AF"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "./plugins/withNetworkSecurityConfig.js",
      "expo-updates",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Microphone is used for voice ordering.",
          "speechRecognitionPermission": "Speech recognition is used to fill order fields from voice."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableJetifier": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "ca204142-be2c-4e3c-bef4-8f680286bde6"
      }
    },
    "owner": "saadkahns-team"
  }
}
