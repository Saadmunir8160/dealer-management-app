{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://dealer-management-app-production.up.railway.app",
        "EXPO_PUBLIC_ENABLE_LOGS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://dealer-management-app-production.up.railway.app",
        "EXPO_PUBLIC_ENABLE_LOGS": "true"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://dealer-management-app-production.up.railway.app",
        "EXPO_PUBLIC_ENABLE_LOGS": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
