{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "paths": {
      "@assets": ["./src/assets"],
      "@assets/*": ["./src/assets/*"],
      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"],
      "@screens": ["./src/screens"],
      "@screens/*": ["./src/screens/*"],
      "@navigation": ["./src/navigation"],
      "@navigation/*": ["./src/navigation/*"],
      "@api": ["./src/api"],
      "@api/*": ["./src/api/*"],
      "@services": ["./src/services"],
      "@services/*": ["./src/services/*"],
      "@hooks": ["./src/hooks"],
      "@hooks/*": ["./src/hooks/*"],
      "@context": ["./src/context"],
      "@context/*": ["./src/context/*"],
      "@store": ["./src/store"],
      "@store/*": ["./src/store/*"],
      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*"],
      "@constants": ["./src/constants"],
      "@constants/*": ["./src/constants/*"],
      "@config": ["./src/config"],
      "@config/*": ["./src/config/*"],
      "@types": ["./src/types"],
      "@theme": ["./src/theme"],
      "@theme/*": ["./src/theme/*"],
      "@mock": ["./src/mock"],
      "@mock/*": ["./src/mock/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "index.js"],
  "exclude": ["node_modules", "android", "ios", "__tests__", "dist"]
}
