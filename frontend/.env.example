# Copy to .env for local Expo (this project's DealerManagement.Api)

EXPO_PUBLIC_APP_ENV=development
# Local DealerManagement.Api (launch profile http → port 5246)
EXPO_PUBLIC_API_URL=http://127.0.0.1:5246
EXPO_PUBLIC_ENABLE_LOGS=true

# Production HTTPS API (DealerManagement on Railway), example:
# EXPO_PUBLIC_API_URL=https://dealer-management-app-production.up.railway.app
# Also set the same host in eas.json preview + production env.
#
# Seed login (DatabaseInitializer):
#   username: admin   OR   email: admin@dealerapp.com
#   password: Admin@123

# ── Voice AI (Gemini via Google AI Studio) ───────────────────────────────────
# Prefer a server proxy so the secret key never ships inside the APK:
# EXPO_PUBLIC_GEMINI_PROXY_URL=https://your-api/voice/gemini-extract
#
# Dev-only direct key (VISIBLE in client bundles — do not use in production APK):
# EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key
# EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
#
# If neither proxy nor key is set, voice falls back to offline local extract.
