# Copy to .env for local Expo Go (optional — config also falls back to LAN IP)
# EXPO_PUBLIC_* are inlined at build time for standalone APK via eas.json

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://192.168.0.111:5246
EXPO_PUBLIC_ENABLE_LOGS=true

# For Norway / remote clients, replace with your hosted API, e.g.:
# EXPO_PUBLIC_API_URL=https://your-api.example.com
